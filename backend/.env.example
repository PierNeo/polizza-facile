# ── OBBLIGATORIE ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Dominio/i del frontend autorizzati (CORS). Separati da virgola. "*" = aperto.
ALLOWED_ORIGINS=https://tuo-dominio.vercel.app

# ── AUTENTICAZIONE (account assicuratori) ────────────────────────────────────
# Segreto per firmare i token di sessione. Genera un valore lungo e casuale e
# NON cambiarlo (cambiarlo invalida tutti i login). Es: openssl rand -hex 32
SESSION_SECRET=
# Durata della sessione in ore (default 168 = 7 giorni)
SESSION_TTL_HOURS=168
# Chiave admin per creare account via POST /api/auth/create-user
ADMIN_KEY=
# (Opzionale) Crea un account iniziale al primo avvio, se non esiste
ADMIN_USERNAME=
ADMIN_PASSWORD=
# (Opzionale, una-tantum) Account a cui assegnare i dati globali già esistenti
# (clienti/polizze/config) — di solito il tuo username.
DATA_OWNER_USERNAME=

# ── PERSISTENZA (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── CRON (sync notturno catalogo CGA) ────────────────────────────────────────
# Il cron deve inviare header: Authorization: Bearer <CRON_API_KEY>
CRON_API_KEY=

# ── MODELLI (opzionali — override senza toccare il codice) ────────────────────
# MODEL_VISION=claude-opus-4-6
# MODEL_TEXT=claude-sonnet-4-6
# MODEL_FAST=claude-haiku-4-5-20251001

# ── LIMITI PDF (opzionali) ───────────────────────────────────────────────────
# MAX_PDF_BYTES=41943040   # 40 MB
# MAX_PDF_PAGES=400
